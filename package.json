{
  "name": "zeter-photo-editor",
  "version": "1.47.25",
  "private": true,
  "type": "module",
  "description": "Local browser-based layered image editor inspired by professional raster editors.",
  "scripts": {
    "build": "node tools/build-bundle.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tools/browser-smoke.mjs",
    "test:browser:brush": "node tools/browser-brush-smoke.mjs",
    "test:browser:pen-smooth": "node tools/browser-pen-smooth-smoke.mjs",
    "test:browser:pen-boolean": "node tools/browser-pen-boolean-smoke.mjs",
    "test:browser:path-node-edit": "node tools/browser-path-node-edit-smoke.mjs",
    "test:browser:raw-dng": "node tools/browser-raw-dng-smoke.mjs",
    "test:browser:psd-isolated": "node tools/browser-isolated-raster-clipping-run.mjs",
    "test:browser:psd-group-mask": "node tools/browser-psd-group-mask-run.mjs",
    "test:browser:psd-nested-alpha": "node tools/browser-psd-nested-alpha-run.mjs",
    "test:browser:psd-clipped-raster": "node tools/browser-psd-clipped-raster-run.mjs",
    "test:browser:paths-layout": "node tools/browser-paths-panel-layout-run.mjs",
    "test:browser:vector-mask": "node tools/browser-vector-mask-controls-smoke.mjs",
    "test:browser:adjustment-create": "node tools/browser-adjustment-create-smoke.mjs",
    "test:browser:adjustment-stack": "node tools/browser-adjustment-stack-smoke.mjs",
    "test:browser:adjustment-mask-direct": "node tools/browser-adjustment-mask-direct-smoke.mjs",
    "test:browser:adjustment-psd-ui": "node tools/browser-adjustment-psd-ui-smoke.mjs",
    "check": "npm run build && node --check src/app.bundle.js && node --check tools/browser-smoke.mjs && npm test",
    "serve": "python3 -m http.server 4173 --directory ."
  }
}
