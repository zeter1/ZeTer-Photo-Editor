{
  "name": "zeter-photo-editor",
  "version": "1.46.6",
  "private": true,
  "type": "module",
  "description": "Local browser-based layered image editor inspired by professional raster editors.",
  "scripts": {
    "build": "node tools/build-bundle.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tools/browser-smoke.mjs",
    "test:browser:pen-smooth": "node tools/browser-pen-smooth-smoke.mjs",
    "test:browser:vector-mask": "node tools/browser-vector-mask-controls-smoke.mjs",
    "test:browser:adjustment-create": "node tools/browser-adjustment-create-smoke.mjs",
    "test:browser:adjustment-stack": "node tools/browser-adjustment-stack-smoke.mjs",
    "check": "npm run build && node --check src/app.bundle.js && node --check tools/browser-smoke.mjs && npm test",
    "serve": "python3 -m http.server 4173 --directory ."
  }
}
